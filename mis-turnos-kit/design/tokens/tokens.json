{
  "name": "Mis turnos",
  "platform": "android",
  "baseScreen": { "width": 390, "height": 844, "unit": "dp" },
  "color": {
    "accent": "#0F6E64",
    "accentDark": "#0B544C",
    "onAccent": "#FFFFFF",
    "surfaceAccent": "#DDF0EC",
    "background": "#FFFFFF",
    "surface": "#F2F2EF",
    "surfaceInput": "#F7F7F4",
    "text": "#1C1C1A",
    "textMuted": "#5F5F5A",
    "textFaint": "#7A7A75",
    "line": "#E6E6E1",
    "lineSoft": "#E8E8E4",
    "handle": "#D8D8D3",
    "danger": "#8A2E1F",
    "scrim": "rgba(20, 20, 19, 0.45)"
  },
  "shift": {
    "libre":      { "label": "Libre",      "short": "LIBRE", "bg": "#F2F2EF", "fg": "#5B5B57", "border": "#E4E4E0", "swatch": "#D9D9D4", "dot": "#9A9A95" },
    "manana":     { "label": "Mañana",     "short": "MAÑ",   "bg": "#FFE9A8", "fg": "#6B4A00", "border": "#F3D77A", "swatch": "#FFD766", "dot": "#D99E00" },
    "tarde":      { "label": "Tarde",      "short": "TARDE", "bg": "#CFE4FF", "fg": "#12407A", "border": "#A9CBF5", "swatch": "#8FBDF5", "dot": "#2F7BD8" },
    "noche":      { "label": "Noche",      "short": "NOCHE", "bg": "#2E2A6B", "fg": "#FFFFFF", "border": "#2E2A6B", "swatch": "#2E2A6B", "dot": "#B9B4FF" },
    "vacaciones": { "label": "Vacaciones", "short": "VAC",   "bg": "#CDEFD5", "fg": "#145229", "border": "#A6DDB4", "swatch": "#8EDBA4", "dot": "#2E9E55" }
  },
  "typography": {
    "family": "Manrope",
    "fallback": "sans-serif",
    "weights": [500, 600, 700, 800],
    "styles": {
      "overline":   { "size": 12, "weight": 700, "letterSpacing": "0.08em", "transform": "uppercase" },
      "title":      { "size": 22, "weight": 800, "letterSpacing": "-0.01em" },
      "sheetTitle": { "size": 20, "weight": 800 },
      "body":       { "size": 16, "weight": 600 },
      "button":     { "size": 16, "weight": 700 },
      "buttonSmall":{ "size": 15, "weight": 700 },
      "dayNumber":  { "size": 15, "weight": 800 },
      "dayTag":     { "size": 10, "weight": 700, "letterSpacing": "0.04em" },
      "chip":       { "size": 12, "weight": 700 },
      "caption":    { "size": 13, "weight": 700 },
      "tabLabel":   { "size": 12, "weight": 700 },
      "tabLabelActive": { "size": 12, "weight": 800 }
    }
  },
  "radius": { "cell": 12, "control": 14, "fab": 18, "sheet": 24, "pill": 999, "swatch": 8, "iconButton": 22 },
  "size": {
    "touchTargetMin": 44,
    "iconButton": 44,
    "button": 52,
    "input": 50,
    "cancelButton": 48,
    "optionRow": 52,
    "taskRowMin": 60,
    "dayCell": 60,
    "checkbox": 24,
    "fab": 60,
    "tabBar": 72,
    "sheetHandle": { "w": 36, "h": 4 }
  },
  "spacing": {
    "screenPadding": 20,
    "gridPadding": 16,
    "gridGap": 6,
    "chipGap": 6,
    "listGap": 8,
    "sheetGap": 14,
    "fabOffset": { "right": 20, "aboveTabBar": 20 }
  },
  "elevation": { "fab": "0 6px 18px rgba(20,20,19,0.22)" }
}
